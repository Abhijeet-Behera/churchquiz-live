# =========================================================
# ChurchQuiz Live - Backend Environment Example
# =========================================================

# Server port
PORT=3000

# Clerk backend authentication
# Replace this placeholder with the real secret only in .env
# NEVER put the actual secret key in this example file.
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Frontend origins allowed to authenticate as Host
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173

# Frontend origins allowed to connect to the backend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174